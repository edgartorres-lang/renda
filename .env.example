# Copie para .env e ajuste:  cp .env.example .env
# Domínio que aponta para o VPS (registro A no DNS). Usado pelo Caddy para o HTTPS.
DOMINIO=renda.setornorteseguros.com.br

# Admin criado no primeiro start (só se o banco estiver vazio). A troca de senha é obrigatória no primeiro login.
ADMIN_EMAIL=voce@setornorteseguros.com.br
ADMIN_SENHA=troque-esta-senha-provisoria

# Segredo das sessões. Gere um novo com:  openssl rand -hex 48
SESSION_SECRET=gere-um-valor-aleatorio-com-openssl-rand-hex-48

# Envio do estudo por e-mail (Google Workspace): o e-mail e uma senha de app do Google
# SMTP_USER=voce@setornorteseguros.com.br
# SMTP_PASS=senha-de-app-de-16-letras

# Opcionais
# APP_PORT=3000          # porta no localhost do VPS (mude se a 3000 estiver ocupada)
# COOKIE_SECURE=true     # só use false para teste local em http
